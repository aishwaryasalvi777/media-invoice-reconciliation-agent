# Template for the private .env file. Copy it with:  cp .env.example .env
# Then put real values in .env. The .env file is never committed to GitHub.
# Every name starts with INVOICE_RECON_ so it can't clash with other apps.

# Folder with the media plan, delivery, contracts and invoices.
# A relative path is read from the project folder.
INVOICE_RECON_DATA_FOLDER=data/sample

# How much detail the app prints: DEBUG, INFO, WARNING or ERROR.
INVOICE_RECON_LOG_LEVEL=INFO

# Secrets are added here later, with placeholder values only, for example:
# INVOICE_RECON_CLAUDE_API_KEY=put-your-key-here
